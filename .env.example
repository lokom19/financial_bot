# ============================================================
# Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ============================================================
# Deployment (для docker + nginx + Let's Encrypt)
# ============================================================
DOMAIN=vm123123new.firstbyte.club
LETSENCRYPT_EMAIL=ты@example.com

# ============================================================
# Database
# ============================================================
# При запуске в Docker: DB_HOST=postgres
# Локально: DB_HOST=localhost
DB_HOST=postgres
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=сгенерируй-длинный-случайный-пароль

# Auth (JWT)
SECRET_KEY=generate-a-long-random-string-here-minimum-32-chars

# Secure cookies — включить когда сайт работает по HTTPS
# (на HTTP они не сработают, поэтому пока false)
COOKIE_SECURE=false

# Cloudflare Turnstile (CAPTCHA на регистрации) — опционально
# Получи на https://dash.cloudflare.com → Turnstile → Add site
# Если пусто — капча отключается (только rate-limit)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# LLM Configuration — choose one or both
# Option 1: Groq API (free tier) — https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Опционально: SOCKS5 proxy для исходящих запросов к Groq
# (если сервер в стране где Groq заблокирован)
# Формат: socks5h://<host>:<port>   (h = name resolution через прокси)
# OUTBOUND_PROXY=socks5h://172.17.0.1:1080

# Option 2: Local Ollama (free, runs locally)
LLM_URL=http://localhost:11434/api/chat
LLM_MODEL=llama3
LLM_TIMEOUT=30

# Streamlit dashboard URL (для ссылки в шапке FastAPI)
STREAMLIT_URL=http://localhost:8501

# Nightly pipeline (SBER + OZON + VTBR, 2:00 ночи)
NIGHTLY_HOUR=2
NIGHTLY_MINUTE=0
NIGHTLY_TRAIN_TIMEOUT=10800        # таймаут обучения в секундах (3 часа)
NIGHTLY_LLM_LOOKBACK_HOURS=12      # сколько часов назад брать записи без LLM
TZ=Europe/Moscow

# Пороги торговых сигналов (в %).
# При target=next_return модель часто предсказывает ±0.1-0.3% →
# при пороге 0.5% получается много NEUTRAL/HOLD. 0.2% даёт активнее сигналы.
SIGNAL_BUY_THRESHOLD=0.2
SIGNAL_SELL_THRESHOLD=-0.2
SIGNAL_NEUTRAL_THRESHOLD=0.05

# Auto-disable моделей с плохой live точностью
MODEL_DISABLE_MIN_SAMPLES=10
MODEL_DISABLE_HIT_RATE=40

# Использовать ли НЕЗАКРЫТУЮ дневную свечу за сегодня (рынок ещё открыт)
# false (default) — берём только полные дни, прогноз стабилен и интерпретируем
# true             — берём текущую неполную, прогноз обновляется в течение дня,
#                    но "close" не финальный, направление может скакать
USE_PARTIAL_CANDLE=false

# Tinkoff Invest API (for data collection)
INVEST_TOKEN=your_tinkoff_invest_token_here

# ============================================================
# Email digest — ежедневная рассылка сигналов подписчикам
# ============================================================
# EMAIL_ENABLED=false — быстро отключает всю систему рассылки
EMAIL_ENABLED=true

# SMTP-провайдер: подойдёт любой (Яндекс, Mail.ru, SendGrid, Mailgun).
# Пример Яндекс.360:
EMAIL_SMTP_HOST=smtp.yandex.ru
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SSL=true                 # для 465. Для 587 поставь false → STARTTLS
EMAIL_SMTP_USER=noreply@your-domain.ru
EMAIL_SMTP_PASSWORD=application-specific-password

# From: адрес, с которого будут уходить письма
EMAIL_FROM=noreply@your-domain.ru
EMAIL_FROM_NAME=Trading Signals

# Когда рассылать (после nightly). Дефолт 8:00 МСК.
EMAIL_DIGEST_HOUR=8
EMAIL_DIGEST_MINUTE=0

# Публичный URL сервиса — идёт в кнопку "Открыть отчёт" и ссылку отписки
PUBLIC_BASE_URL=https://trading-signals.your-domain.ru

# Kafka Configuration (for model trainer)
KAFKA_BROKER=localhost:9092
KAFKA_TOPIC=data_collection_status
CONSUMER_GROUP=model_trainer_group
KAFKA_TOPIC_PRODUCER=model_trainer_status

# Directory Configuration
DATAFRAMES_DIR=/path/to/dataframes
OUTPUT_DIR=/path/to/output
WAIT_TIMEOUT=15000
